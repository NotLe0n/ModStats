{{define "1.4/author_list.gohtml"}}
<!DOCTYPE html>
<html lang="en">
	<head>
		<title>Mod Statistics // Author List</title>
		<link rel="stylesheet" href="/static/css/standart.css" />
		<link rel="icon" type="image/png" sizes="any" href="/static/assets/favicon.ico">

		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta content="#43B581" data-react-helmet="true" name="theme-color">
	</head>
	<body>
		{{ template "sidebar" }}
		<header>
			<h1 id="hamburger" onclick="openNav()">☰</h1>
			<h1><span><a href=".">Mod Statistics</a> // </span><wbr><span>Mod List</span></h1>
			<div class="input-container">
				{{ template "base/search_element.gohtml" .modlist }}
			</div>
			{{ template "base/search_script.gohtml" }}
		</header>
		<main id="content" onclick="closeNav()">
			<table>
				<thead>
					<tr>
						<th>Rank</th>
						<th>Names</th>
						<th>Total Downloads</th>
						<th>Total Views</th>
						<th>Total Favorites</th>
						<th>Mods</th>
					</tr>
				</thead>
				<tbody>
					{{ range $i, $author := .authors }}
						<tr>
							<td>{{ len (printf "a%*s" $i "") }}.</td>
							<td>
								{{ range $j, $name := $author.Names }}{{if $j}}, {{end}}<a href="/author/{{ $author.Author }}">"<code>{{ $name }}</code>"{{end}}
							</td>
							<td>{{ $author.TotalDownloads }}</td>
							<td>{{ $author.TotalViews }}</td>
							<td>{{ $author.TotalFavorites }}</td>
							<td>
								{{ range $k, $m := $author.Mods }}{{if $k}}, {{end}}<a href="/mod/{{$m.ModID}}">"<code>{{ $m.DisplayName }}</code>"</a>{{end}}
							</td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</main>
	</body>
</html>
{{end}}